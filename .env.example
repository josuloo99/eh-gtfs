# Copy to .env (git ignores it) next to docker-compose.yml. Everything here is optional.

# API key of the Spanish Ministry's National Access Point (https://nap.transportes.gob.es), personal and secret.
# It adds the Nafarroa operators (Interurbano de Navarra, Villavesas) and ALSA. Without it the app works as before
# and keeps any of them it had already imported.
NAP_API_KEY=

# User/group of the container. Only change them if you replace the data volume with a host folder (ids from `id -u`, `id -g`)
#APP_UID=1000
#APP_GID=1000

# Threads of the walking router (Valhalla) that answers the directions screen; more makes a graph build faster.
#VALHALLA_THREADS=2
